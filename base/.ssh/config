# Single GitHub account over SSH.
#
# Generate the key once per machine (see README):
#   ssh-keygen -t ed25519 -C "you@example.com"
# then add ~/.ssh/id_ed25519.pub to GitHub under Settings -> SSH keys.
#
# Use a key with a different name? Change IdentityFile below.

Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	AddKeysToAgent yes

# Load keys into a running ssh-agent and keep connections warm. Remove these
# two lines if your agent is managed elsewhere (e.g. 1Password).
Host *
	AddKeysToAgent yes
	ServerAliveInterval 60
